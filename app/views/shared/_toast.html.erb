<% if flash[:alert].present? %>
  <div
    data-controller="toast"
    class="fixed bottom-6 right-6 z-50 flex max-w-sm items-start gap-3 rounded-md bg-slate-900 px-4 py-3 text-sm text-white shadow-lg"
  >
    <p class="flex-1"><%= flash[:alert] %></p>
    <button
      type="button"
      data-action="toast#dismiss"
      aria-label="Dismiss"
      class="rounded-full px-1 leading-none text-slate-300 transition hover:bg-slate-700 hover:text-white"
    >
      &times;
    </button>
  </div>
<% end %>
