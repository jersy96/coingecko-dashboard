<%
  last_page = [ (@activity_page.total_count.to_f / @activity_page.page_size).ceil, 1 ].max if @activity_page.page_size.positive?
%>

<h1 class="text-2xl font-semibold text-slate-900">Activity log</h1>
<p class="mt-1 text-sm text-slate-500">Every action users take on this dashboard.</p>

<% if @activity_page.entries.empty? %>
  <p class="mt-6 rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-500">
    Nothing recorded yet.
  </p>
<% else %>
  <div class="mt-6 overflow-x-auto rounded-md border border-slate-200 bg-white">
    <table class="w-full min-w-max text-left text-sm">
      <thead class="bg-slate-50 text-xs font-medium uppercase tracking-wide text-slate-400">
        <tr>
          <th class="px-4 py-3">When</th>
          <th class="px-4 py-3">Who</th>
          <th class="px-4 py-3">Action</th>
          <th class="px-4 py-3">Asset</th>
          <th class="px-4 py-3">Details</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% @activity_page.entries.each do |activity_entry| %>
          <tr>
            <td class="px-4 py-3 text-slate-500"><%= activity_entry.occurred_at.strftime("%b %d, %Y %H:%M") %></td>
            <td class="px-4 py-3">
              <p class="font-medium text-slate-900"><%= activity_entry.user.email %></p>
              <p class="text-xs capitalize text-slate-400"><%= activity_entry.user.role %></p>
            </td>
            <td class="px-4 py-3 text-slate-700"><%= activity_entry.action.tr(".", " ").humanize %></td>
            <td class="px-4 py-3 font-medium text-slate-900"><%= activity_entry.subject.humanize %></td>
            <td class="px-4 py-3 text-xs text-slate-400"><%= activity_entry.details.to_json %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex items-center justify-between text-sm text-slate-500">
    <p>Page <%= @activity_page.page %> of <%= last_page %> — <%= @activity_page.total_count %> entries</p>

    <div class="flex gap-2">
      <% if @activity_page.page > 1 %>
        <%= link_to "Previous", activity_entries_path(page: @activity_page.page - 1), class: "rounded-md border border-slate-300 px-3 py-1 font-medium text-slate-700 transition hover:bg-slate-50" %>
      <% end %>
      <% if @activity_page.page < last_page %>
        <%= link_to "Next", activity_entries_path(page: @activity_page.page + 1), class: "rounded-md border border-slate-300 px-3 py-1 font-medium text-slate-700 transition hover:bg-slate-50" %>
      <% end %>
    </div>
  </div>
<% end %>
