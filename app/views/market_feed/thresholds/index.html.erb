<h1 class="text-2xl font-semibold text-slate-900">Thresholds</h1>
<p class="mt-1 text-sm text-slate-500">Global alert triggers. Every user sees the colours; only an admin sets them.</p>

<div class="mt-6 space-y-4">
  <% @thresholds.each do |threshold| %>
    <%= form_with url: threshold_path(threshold.metric), method: :patch, class: "rounded-md border border-slate-200 bg-white p-4" do %>
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-slate-900"><%= threshold.metric.humanize %></p>
        <% if threshold.new_record? %>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">Not set</span>
        <% end %>
      </div>

      <p class="mt-1 text-xs text-slate-400">
        Colours the <%= threshold_column_label(threshold.metric) %> column · value in <%= threshold.unit %> ·
        <%= threshold.higher_is_worse? ? "higher is worse" : "lower is worse" %>
      </p>

      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3 sm:items-end">
        <div>
          <label class="text-xs font-medium uppercase tracking-wide text-slate-400" for="alert_value_<%= threshold.metric %>">Alert</label>
          <%= number_field_tag :alert_value, threshold.alert_value, step: "any",
                id: "alert_value_#{threshold.metric}",
                class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
        </div>

        <div>
          <label class="text-xs font-medium uppercase tracking-wide text-slate-400" for="good_value_<%= threshold.metric %>">Good</label>
          <%= number_field_tag :good_value, threshold.good_value, step: "any",
                id: "good_value_#{threshold.metric}",
                class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
        </div>

        <%= submit_tag "Save",
              class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2" %>
      </div>
    <% end %>
  <% end %>
</div>
