<h1 class="text-2xl font-semibold text-slate-900">Watchlist</h1>
<p class="mt-1 text-sm text-slate-500">
  <% if @watchlist_owner == Current.user %>
    The assets this dashboard opens with.
  <% else %>
    Viewing the watchlist of <%= @watchlist_owner.email %>.
  <% end %>
</p>

<% if allowed_to?(:manage_any_watchlist) %>
  <%= form_with url: watchlist_items_path, method: :get, class: "mt-6 flex items-end gap-3 rounded-md border border-slate-200 bg-white p-4" do %>
    <div class="flex-1">
      <label class="text-xs font-medium uppercase tracking-wide text-slate-400" for="user_id">Whose watchlist</label>
      <%= select_tag :user_id,
            options_from_collection_for_select(@available_users, :id, ->(user) { "#{user.email} (#{user.role})" }, @watchlist_owner.id),
            id: "watchlist-owner",
            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900" %>
    </div>
    <%= submit_tag "View",
          class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2" %>
  <% end %>
<% end %>

<% if @watched_items.any? %>
  <%= link_to "Watch",
        root_path(asset_ids: @watched_items.map(&:asset_id)),
        id: "watch-watchlist",
        class: "mt-6 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2" %>
<% end %>

<% if @watched_items.empty? %>
  <p class="mt-6 rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-500">
    No assets yet. Add one from the star on the Market Feed table.
  </p>
<% else %>
  <div class="mt-6 overflow-hidden rounded-md border border-slate-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-medium uppercase tracking-wide text-slate-400">
        <tr>
          <th class="px-4 py-3">Asset</th>
          <th class="px-4 py-3">Added</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% @watched_items.each do |watched_item| %>
          <tr>
            <td class="px-4 py-3 font-medium text-slate-900"><%= watched_item.asset_id.humanize %></td>
            <td class="px-4 py-3 text-slate-500"><%= watched_item.created_at.strftime("%b %d, %Y %H:%M") %></td>
            <td class="px-4 py-3 text-right">
              <%= button_to "Remove",
                    watchlist_item_path(watched_item.asset_id),
                    method: :delete,
                    params: { user_id: (@watchlist_owner.id if @watchlist_owner != Current.user) }.compact,
                    form: { data: { turbo_confirm: "Remove #{watched_item.asset_id.humanize} from this watchlist?" } },
                    class: "rounded-md border border-slate-300 px-3 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
