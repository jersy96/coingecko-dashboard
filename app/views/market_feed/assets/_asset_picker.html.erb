<%
  asset_picker_labels = market_feed_assets.each_with_object({}) do |asset, labels|
    labels[asset.id] = "#{asset.name} (#{asset.id})"
  end
  selected_asset_ids = requested_asset_ids.presence || market_feed_assets.map(&:id)
%>

<div
  class="grid gap-y-3 md:row-span-3 md:grid-rows-subgrid"
  data-controller="asset-picker"
  data-asset-picker-selected-value="<%= selected_asset_ids.to_json %>"
  data-asset-picker-labels-value="<%= asset_picker_labels.to_json %>"
  data-asset-picker-url-value="<%= asset_catalog_path %>"
>
  <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Assets</p>

  <div class="relative">
    <div data-asset-picker-target="chipsPanel">
      <div data-asset-picker-target="chips" class="flex flex-wrap content-start items-start gap-2 overflow-hidden"></div>
      <button
        type="button"
        data-asset-picker-target="expandToggle"
        data-action="asset-picker#toggleExpanded"
        class="mt-2 hidden text-xs font-medium text-slate-500 transition hover:text-slate-900"
      ></button>
    </div>
  </div>

  <div data-asset-picker-target="hiddenFields" class="hidden"></div>

  <div class="relative">
    <input
      type="search"
      placeholder="Search assets"
      autocomplete="off"
      data-asset-picker-target="query"
      data-action="input->asset-picker#search focus->asset-picker#openResults blur->asset-picker#closeResults"
      class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
    >

    <ul
      data-asset-picker-target="results"
      class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-56 divide-y divide-slate-100 overflow-y-auto rounded-md border border-slate-200 bg-white shadow-lg"
    ></ul>
  </div>

</div>
