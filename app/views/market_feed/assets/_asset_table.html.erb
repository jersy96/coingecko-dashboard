<%
  market_feed_chart_assets = market_feed_assets.map do |asset|
    {
      id: asset.id,
      name: asset.name,
      prices: asset.price_history_values,
      labels: asset.price_history.each_with_index.map do |point, index|
        index == asset.price_history.size - 1 ? "Now" : point.recorded_at.strftime("%b %d")
      end
    }
  end
%>

<section
  data-controller="market-feed"
  data-market-feed-assets-value="<%= market_feed_chart_assets.to_json %>"
  data-market-feed-selected-asset-id-value="<%= market_feed_assets.first&.id %>"
>
  <h2 class="text-xl font-semibold text-slate-900">Market Feed</h2>
  <p class="mt-1 text-sm text-slate-500">Live crypto asset metrics from CoinGecko.</p>

  <%= render "pickers", market_feed_assets: market_feed_assets, selected_currencies: selected_currencies, supported_currencies: supported_currencies %>

  <fieldset class="mt-6 flex flex-wrap gap-4 rounded-md border border-slate-200 bg-white p-4">
    <legend class="px-1 text-xs font-medium uppercase tracking-wide text-slate-400">Metrics</legend>

    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
      <input
        type="checkbox"
        checked
        data-action="market-feed#toggleMetric"
        data-market-feed-metric-param="price"
        class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900"
      >
      Asset Price
    </label>

    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
      <input
        type="checkbox"
        checked
        data-action="market-feed#toggleMetric"
        data-market-feed-metric-param="volatility"
        class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900"
      >
      24h Volatility
    </label>

    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
      <input
        type="checkbox"
        checked
        data-action="market-feed#toggleMetric"
        data-market-feed-metric-param="conversion"
        class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900"
      >
      FX Conversion Rates
    </label>

    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
      <input
        type="checkbox"
        checked
        data-action="market-feed#toggleMetric"
        data-market-feed-metric-param="market-cap"
        class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900"
      >
      Market Cap
    </label>
  </fieldset>

  <div class="mt-6 space-y-6">
    <div class="rounded-md border border-slate-200 bg-white p-4">
      <div class="h-80">
        <canvas data-market-feed-target="chartCanvas"></canvas>
      </div>
    </div>

    <div class="overflow-x-auto rounded-md border border-slate-200 bg-white">
      <table class="w-full min-w-max text-left text-sm">
      <thead class="bg-slate-50 text-xs font-medium uppercase tracking-wide text-slate-400">
        <tr>
          <th class="sticky left-0 z-10 bg-slate-50 px-4 py-3">Asset</th>
          <th data-market-feed-target="priceColumn" class="px-4 py-3">Asset Price</th>
          <th data-market-feed-target="volatilityColumn" class="px-4 py-3">24h Volatility</th>
          <% selected_currencies.reject { |currency| currency == MarketFeed::Asset::BASE_CURRENCY }.each do |currency| %>
            <th data-market-feed-target="conversionColumn" class="px-4 py-3"><%= currency.upcase %></th>
          <% end %>
          <th data-market-feed-target="marketCapColumn" class="px-4 py-3">Market Cap</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% market_feed_assets.each do |asset| %>
          <tr
            data-market-feed-target="assetRow"
            data-market-feed-asset-id-param="<%= asset.id %>"
            data-action="click->market-feed#selectAsset"
            class="group cursor-pointer transition hover:bg-slate-50 <%= "bg-slate-100" if asset == market_feed_assets.first %>"
          >
            <td
              data-market-feed-target="assetCell"
              class="sticky left-0 z-10 px-4 py-3 transition group-hover:bg-slate-50 <%= asset == market_feed_assets.first ? "bg-slate-100" : "bg-white" %>"
            >
              <div class="flex items-center gap-2">
                <% if allowed_to?(:manage_own_watchlist) %>
                  <% if watched_asset_ids.include?(asset.id) %>
                    <%= button_to "★",
                          watchlist_item_path(asset.id),
                          method: :delete,
                          form: { data: { turbo_confirm: "Remove #{asset.name} from your watchlist?" } },
                          title: "Remove from watchlist",
                          class: "text-base leading-none text-amber-500" %>
                  <% else %>
                    <%= button_to "☆",
                          watchlist_items_path(asset_id: asset.id),
                          form: { data: { turbo: false } },
                          title: "Add to watchlist",
                          class: "text-base leading-none text-slate-300 transition hover:text-amber-500" %>
                  <% end %>
                <% end %>
                <div>
                  <p class="font-medium text-slate-900"><%= asset.name %></p>
                  <p class="text-xs text-slate-400"><%= asset.symbol %></p>
                </div>
              </div>
            </td>
            <td data-market-feed-target="priceColumn" class="px-4 py-3 font-medium <%= threshold_cell_classes(threshold_statuses, asset, MarketFeed::Threshold::DAILY_CHANGE_ALERT) %>">
              <%= number_to_currency(asset.current_price) %>
            </td>
            <td data-market-feed-target="volatilityColumn" class="px-4 py-3 <%= threshold_cell_classes(threshold_statuses, asset, MarketFeed::Threshold::VOLATILITY_ALERT) %>">
              <%= asset.daily_range ? number_to_percentage(asset.daily_range * 100, precision: 2) : "—" %>
            </td>
            <% selected_currencies.reject { |currency| currency == MarketFeed::Asset::BASE_CURRENCY }.each do |currency| %>
              <td data-market-feed-target="conversionColumn" class="px-4 py-3 text-slate-700">
                <%= number_to_currency(asset.conversion_rate_in(currency)&.price, unit: "") %>
              </td>
            <% end %>
            <td data-market-feed-target="marketCapColumn" class="px-4 py-3 <%= threshold_cell_classes(threshold_statuses, asset, MarketFeed::Threshold::MARKET_CAP_FLOOR) %>">
              <%= number_to_currency(asset.market_cap, precision: 0) %>
            </td>
          </tr>
        <% end %>
      </tbody>
      </table>
    </div>
  </div>
</section>
