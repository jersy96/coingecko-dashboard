<div
  class="grid gap-y-3 md:row-span-3 md:grid-rows-subgrid"
  data-controller="currency-picker"
  data-currency-picker-selected-value="<%= selected_currencies.to_json %>"
  data-currency-picker-supported-value="<%= supported_currencies.to_json %>"
>
  <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Currencies</p>

  <div class="relative">
    <div data-currency-picker-target="chipsPanel">
      <div data-currency-picker-target="chips" class="flex flex-wrap content-start items-start gap-2 overflow-hidden"></div>
      <button
        type="button"
        data-currency-picker-target="expandToggle"
        data-action="currency-picker#toggleExpanded"
        class="mt-2 hidden text-xs font-medium text-slate-500 transition hover:text-slate-900"
      ></button>
    </div>
  </div>

  <div data-currency-picker-target="hiddenFields" class="hidden"></div>

  <div class="relative">
    <input
      type="search"
      placeholder="Search currencies"
      autocomplete="off"
      data-currency-picker-target="query"
      data-action="input->currency-picker#filter focus->currency-picker#openResults blur->currency-picker#closeResults"
      class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
    >

    <ul
      data-currency-picker-target="results"
      class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-56 divide-y divide-slate-100 overflow-y-auto rounded-md border border-slate-200 bg-white shadow-lg"
    ></ul>
  </div>
</div>
