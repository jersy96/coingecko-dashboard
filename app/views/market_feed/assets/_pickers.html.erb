<form
  method="get"
  action="<%= root_path %>"
  data-controller="picker-form"
  data-action="picker:changed->picker-form#pickerChanged"
  class="mt-6 grid grid-cols-1 gap-6 rounded-md border border-slate-200 bg-white p-4 md:grid-cols-2"
>
  <%= render "asset_picker", market_feed_assets: market_feed_assets %>
  <%= render "currency_picker", selected_currencies: selected_currencies, supported_currencies: supported_currencies %>

  <div class="md:col-span-2">
    <button
      type="submit"
      disabled
      data-picker-form-target="apply"
      data-turbo-submits-with="Applying…"
      class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2 disabled:cursor-not-allowed disabled:bg-slate-400"
    >
      Apply
    </button>
  </div>
</form>
